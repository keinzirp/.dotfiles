#!/usr/bin/env -S nu --no-config-file
#MISE description="Update global tools, packages, extensions, and shell integrations"
#MISE dir="~"

use ../scripts/integrations.nu refresh-integrations

do --capture-errors {
    print "==> mise and managed tools"
    ^mise self-update -y
    ^mise upgrade --global -y

    print ""
    print "==> bootstrap packages"
    ^mise -C $env.HOME bootstrap packages upgrade -y

    if (which brew | is-not-empty) {
        print ""
        print "==> Homebrew-owned apps"
        ^brew update
        ^brew upgrade --cask
    }

    print ""
    print "==> pi extensions"
    ^pi update --extensions

    print ""
    print "==> kak (plug.kak)"
    ^kak -ui dummy -e 'set-option global plug_block_ui true; plug-update; quit!'

    refresh-integrations
    ^mise activate nu | save --force ($nu.cache-dir | path join "mise.nu")
}

+static Key normalize_shifted_key(Key key, Codepoint shifted_key = 0)
+{
+    if (not (key.modifiers & Key::Modifiers::Shift))
+        return key;
+
+    if (shifted_key != 0)
+    {
+        key.modifiers &= ~Key::Modifiers::Shift;
+        key.key = shifted_key;
+    }
+    else if (is_basic_alpha(key.key))
+    {
+        // Multiplexers that do not support alternate keys report shifted
+        // letters with their unshifted codepoint and a Shift modifier.
+        key.modifiers &= ~Key::Modifiers::Shift;
+        key.key = to_upper(key.key);
+    }
+    return key;
+}
+
+UnitTest test_terminal_shifted_key_fallback{[]()
+{
+    kak_assert(normalize_shifted_key({Key::Modifiers::Alt | Key::Modifiers::Shift, 'o'}) == alt('O'));
+    kak_assert(normalize_shifted_key({Key::Modifiers::Alt | Key::Modifiers::Shift, 'o'}, 'O') == alt('O'));
+}};

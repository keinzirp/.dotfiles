font-family = LiterationMono Nerd Font Mono
font-size = 18
font-thicken = true

theme = Alacritty
cursor-style-blink = false

# Nushell already starts Zellij.
command = /opt/homebrew/bin/nu
macos-option-as-alt = left
maximize = true
window-decoration = none
window-padding-x = 0
window-padding-y = 0
resize-overlay = never
# Zellij owns session restoration.
window-save-state = never
confirm-close-surface = always
copy-on-select = clipboard

# Zellij owns panes; Ghostty splits would start independent Zellij sessions.
keybind = super+d=ignore
keybind = super+shift+d=ignore
keybind = super+w=ignore
keybind = shift+enter=text:\x1b\r
keybind = alt+shift+k=text:\x1bK
keybind = alt+shift+9=text:\x1b(
keybind = alt+shift+0=text:\x1b)

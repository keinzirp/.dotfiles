# Base16 Default Dark, translated from Helix's base16_default_dark theme.

# Code
face global value rgb:dc9656
face global type rgb:f7ca88
face global variable rgb:ab4642
face global module rgb:ba8baf
face global function rgb:7cafc2
face global string rgb:a1b56c
face global keyword rgb:ba8baf
face global operator rgb:d8d8d8
face global attribute rgb:dc9656
face global comment rgb:b8b8b8+i
face global documentation comment
face global meta rgb:7cafc2
face global builtin rgb:7cafc2

# Markup
face global title rgb:7cafc2
face global header rgb:7cafc2
face global mono rgb:a1b56c
face global block rgb:ba8baf+i
face global link rgb:dc9656+u
face global bullet rgb:ab4642
face global list rgb:ab4642

# Interface
face global Default rgb:d8d8d8,rgb:181818
face global PrimarySelection rgb:d8d8d8,rgb:383838+fg
face global SecondarySelection rgb:d8d8d8,rgb:383838+fg
face global PrimaryCursor rgb:181818,rgb:d8d8d8+fg
face global SecondaryCursor rgb:181818,rgb:b8b8b8+fg
face global PrimaryCursorEol rgb:181818,rgb:d8d8d8+fg
face global SecondaryCursorEol rgb:181818,rgb:b8b8b8+fg
face global LineNumbers rgb:585858,rgb:282828
face global LineNumberCursor rgb:b8b8b8,rgb:282828+b
face global LineNumbersWrapped rgb:585858,rgb:282828
face global MenuForeground rgb:181818,rgb:7cafc2
face global MenuBackground rgb:d8d8d8,rgb:282828
face global MenuInfo rgb:7cafc2,rgb:282828
face global Information rgb:e8e8e8,rgb:282828
face global InlineInformation rgb:e8e8e8,rgb:282828
face global Error rgb:ab4642,rgb:282828
face global DiagnosticError rgb:ab4642
face global DiagnosticWarning rgb:dc9656
face global StatusLine rgb:b8b8b8,rgb:282828
face global StatusLineMode rgb:d8d8d8,rgb:282828+b
face global StatusLineInfo rgb:7cafc2,rgb:282828
face global StatusLineValue rgb:a1b56c,rgb:282828
face global StatusCursor rgb:181818,rgb:d8d8d8
face global Prompt rgb:e8e8e8,rgb:282828
face global MatchingChar rgb:f7ca88,rgb:181818+u
face global Whitespace rgb:585858+f
face global BufferPadding rgb:585858,rgb:181818

# Tree-sitter capture faces.
face global ts_attribute attribute
face global ts_comment comment
face global ts_constant value
face global ts_constructor type
face global ts_function function
face global ts_keyword keyword
face global ts_namespace module
face global ts_operator operator
face global ts_property variable
face global ts_punctuation Default
face global ts_special builtin
face global ts_string string
face global ts_tag keyword
face global ts_text Default
face global ts_type type
face global ts_variable variable

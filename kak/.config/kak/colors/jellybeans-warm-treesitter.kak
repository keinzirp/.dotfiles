# jellybeans-warm with kak-tree-sitter faces, translated from the Neovim jellybeans-warm palette.

# Code
face global value rgb:d98870
face global type rgb:e6a75a+i
face global variable rgb:e0cebc
face global module rgb:c8b878+i
face global function rgb:fbd587
face global string rgb:99ad6a
face global keyword rgb:c6b6ee
face global operator rgb:c8b878
face global attribute rgb:8197bf
face global comment rgb:8a8070+i
face global documentation comment
face global meta rgb:8197bf
face global builtin rgb:8197bf+b

# Markup
face global title rgb:70b950+b
face global header rgb:8fbfdc
face global mono rgb:e6a75a
face global block rgb:c6b6ee
face global link rgb:d2ebbe+u
face global bullet rgb:d98870+b
face global list rgb:8fbfdc

# Interface
face global Default rgb:edd9b8,rgb:1c1510
face global PrimarySelection rgb:edd9b8,rgb:4a3828+fg
face global SecondarySelection rgb:edd9b8,rgb:352519+fg
face global PrimaryCursor rgb:1c1510,rgb:e0cebc+fg
face global SecondaryCursor rgb:1c1510,rgb:d0c0a8+fg
face global PrimaryCursorEol rgb:1c1510,rgb:e0cebc+fg
face global SecondaryCursorEol rgb:1c1510,rgb:d0c0a8+fg
face global LineNumbers rgb:6a5a50
face global LineNumberCursor rgb:d0c0a8,rgb:241a10+b
face global LineNumbersWrapped rgb:4a3828
face global MenuForeground rgb:edd9b8,rgb:2b5b77+b
face global MenuBackground rgb:edd9b8,rgb:352519
face global MenuInfo rgb:8fbfdc
face global Information rgb:edd9b8,rgb:3c2c1c
face global InlineInformation rgb:edd9b8,rgb:3c2c1c
face global Error rgb:edd9b8,rgb:d74545
face global DiagnosticError rgb:d74545
face global DiagnosticWarning rgb:ffaf00
face global StatusLine rgb:ffffff,rgb:241a10
face global StatusLineMode rgb:70b950,rgb:241a10+b
face global StatusLineInfo rgb:8fbfdc,rgb:241a10
face global StatusLineValue rgb:d2ebbe,rgb:241a10
face global StatusCursor rgb:1c1510,rgb:e0cebc
face global Prompt rgb:e6a75a,rgb:1c1510
face global MatchingChar rgb:cc88a3,rgb:302028+b
face global Whitespace rgb:665850+f
face global BufferPadding rgb:665850,rgb:1c1510

# Tree-sitter top-level capture faces. Descendant captures inherit these.
face global ts_attribute attribute
face global ts_comment comment
face global ts_conceal Default
face global ts_constant value
face global ts_constructor type
face global ts_diff_plus string
face global ts_diff_minus Error
face global ts_diff_delta keyword
face global ts_error Error
face global ts_function function
face global ts_hint Information
face global ts_info Information
face global ts_keyword keyword
face global ts_label keyword
face global ts_markup_bold rgb:edd9b8+b
face global ts_markup_heading title
face global ts_markup_italic rgb:edd9b8+i
face global ts_markup_list_checked bullet
face global ts_markup_list_numbered bullet
face global ts_markup_list_unchecked bullet
face global ts_markup_list_unnumbered bullet
face global ts_markup_link_label link
face global ts_markup_link_url link
face global ts_markup_link_uri link
face global ts_markup_link_text link
face global ts_markup_quote comment
face global ts_markup_raw mono
face global ts_markup_strikethrough rgb:8a8070+s
face global ts_namespace module
face global ts_operator operator
face global ts_property variable
face global ts_punctuation Default
face global ts_special builtin
face global ts_spell rgb:edd9b8+u
face global ts_string string
face global ts_tag keyword
face global ts_text Default
face global ts_type type
face global ts_variable variable
face global ts_warning DiagnosticWarning
